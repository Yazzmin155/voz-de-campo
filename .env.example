# Copia este archivo como .env.local y completa los valores.
# .env.local está en .gitignore: nunca subas tu clave real.

# Clave de la API de Gemini (Google AI Studio). Solo la lee el servidor.
GEMINI_API_KEY=

# Modelo de Gemini para analizar los registros.
GEMINI_MODELO=gemini-3.5-flash-lite

# Solo para la app Android (build de producción): URL pública del despliegue con /api.
# Ejemplo en .env.production: VITE_API_BASE=https://tu-app.vercel.app
# En la web déjala vacía.
VITE_API_BASE=
